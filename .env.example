# 复制为 .env 并填入真实值（.env 已在 .gitignore 里，不会进版本库）。
# 也可以直接 export 到 shell 环境，运行时优先读环境变量。

# OpenAI 兼容端点。DeepSeek 官方：https://api.deepseek.com/v1
ASC_AGENT_BASE_URL=https://api.deepseek.com/v1

# 你的 API key（不要把真实 key 提交到仓库）
ASC_AGENT_API_KEY=

# 模型名以服务端 /v1/models 返回为准
# DeepSeek 官方可选：deepseek-flash / deepseek-v4-pro
ASC_AGENT_MODEL=deepseek-flash

# 可选：换资料库位置 / 索引位置 / 知识卡片位置
# ASC_DEVKIT_ROOT=./asc-devkit
# ASC_AGENT_DATA=./data
# ASC_AGENT_KNOWLEDGE=./knowledge

# 可选：本地 MCP server 端口
# ASC_AGENT_PORT=8931
